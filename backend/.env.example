# Copia este archivo a .env y completa los valores reales.
# NUNCA commitear .env con credenciales reales.

# Base de datos
DATABASE_URL=postgresql+asyncpg://user:pass@localhost/eventos_db

# IA
GEMINI_API_KEY=

# Almacenamiento
STORAGE_BUCKET=eventos-referencias
STORAGE_BASE_URL=http://localhost:8000
STORAGE_BACKEND=local

# Supabase (solo cuando STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Seguridad — staff JWT
SECRET_KEY=cambiar-en-produccion

# Seguridad — tokens firmados de cliente (self-contained, sin BD)
# Usar un secreto DISTINTO de SECRET_KEY
CLIENT_TOKEN_SECRET=cambiar_en_produccion

# Frontend — URL base para construir links de cliente
FRONTEND_BASE_URL=https://tu-app.vercel.app

# App
DEBUG=false
