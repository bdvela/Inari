# === RAILWAY ENVIRONMENT VARIABLES ===
# Copiar estas variables al dashboard de Railway → Variables

# Base de datos (Railway PostgreSQL — se llena automático si usas
# el plugin de PostgreSQL de Railway)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/railway

# Gemini API
GEMINI_API_KEY=tu-api-key-de-google-ai-studio

# Seguridad — generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera-uno-nuevo-minimo-32-chars

# CORS — URL del frontend en Vercel (se conoce después del deploy)
ALLOWED_ORIGINS=https://inari-frontend.vercel.app,http://localhost:5173

# Storage — usar Supabase Storage en producción
STORAGE_BACKEND=supabase
STORAGE_BUCKET=eventos-referencias
STORAGE_BASE_URL=https://[project-id].supabase.co/storage/v1

# Supabase (para storage de imágenes)
SUPABASE_URL=https://[project-id].supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase

# Optimizer (valores por defecto son correctos para producción)
OPTIMIZER_ILP_MAX_COMBINATIONS=500
PREMIUM_BUDGET_MULTIPLIER=1.30
VISION_MODEL=gemini-2.5-flash
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false
