# Copiar a .env y completar valores reales
# NUNCA commitear .env con credenciales reales

# ── Docker Compose ───────────────────────────────
# Usadas por docker-compose.yml para el contenedor de BD
POSTGRES_USER=inari
POSTGRES_PASSWORD=inari_dev
POSTGRES_DB=eventos_db

# ── Backend (desarrollo local sin Docker) ────────
# Para Docker, la DATABASE_URL se arma automáticamente desde las vars de arriba
DATABASE_URL=postgresql+asyncpg://inari:inari_dev@localhost:5432/eventos_db

# ── Google Gemini (análisis visual) ─────────────
# Obtener en: https://aistudio.google.com → Get API key
GEMINI_API_KEY=AIza...

# ── CORS ─────────────────────────────────────────
# En Railway: agregar la URL del frontend desplegado separada por coma
# Ej: ALLOWED_ORIGINS=https://inari-frontend.up.railway.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Seguridad JWT ────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-en-produccion-usar-secreto-largo-y-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Storage ──────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_BASE_URL=http://localhost:8000

# ── Optimizador ──────────────────────────────────
OPTIMIZER_ILP_MAX_COMBINATIONS=500
PREMIUM_BUDGET_MULTIPLIER=1.30
QUALITY_WEIGHT_HISTORICAL=0.5
QUALITY_WEIGHT_PRICE=0.3
QUALITY_WEIGHT_EXPERIENCE=0.2

# ── Gemini Vision Model ──────────────────────────
# gemini-2.5-flash = recomendado | gemini-2.5-flash-lite = más rápido y barato
VISION_MODEL=gemini-2.5-flash

# ── App ──────────────────────────────────────────
DEBUG=false
